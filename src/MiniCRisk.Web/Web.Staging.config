<?xml version="1.0" encoding="utf-8"?>
<!-- Transform for the Staging environment. Re-pointing these values is part of the migration. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="Vault_Uri" value="https://minicrisk-stg-kv.vault.azure.net/" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Scoring_Endpoint" value="http://localhost:8000/score" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
</configuration>
